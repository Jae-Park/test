# 요약 엔진: cli(기본) = 로그인된 claude CLI 구독 사용, 추가 청구 없음
#            api        = Anthropic API 키 사용 (별도 토큰 과금)
# SUMMARY_ENGINE=cli

# api 엔진을 쓸 때만 필요 (cli 엔진은 불필요)
# ANTHROPIC_API_KEY=sk-ant-...

# Telegram 봇 (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=123456:ABC-...
# 라운드업을 받을 chat id (개인 DM, 그룹, 채널 id)
TELEGRAM_CHAT_ID=123456789

# 선택: 모델 지정 (미지정 시 cli는 구독 기본 모델, api는 claude-opus-4-7)
# NEWS_MODEL=claude-haiku-4-5

# 선택: 수집 시간창(시간 단위, 기본 24)
# TIME_WINDOW_HOURS=24
