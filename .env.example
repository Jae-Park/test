# Anthropic API (요약/큐레이션)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram 봇 (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=123456:ABC-...
# 라운드업을 받을 chat id (개인 DM, 그룹, 채널 id)
TELEGRAM_CHAT_ID=123456789

# 선택: 모델 교체 (기본 claude-opus-4-7). 비용 절감 시 claude-haiku-4-5 / claude-sonnet-4-6
# NEWS_MODEL=claude-haiku-4-5

# 선택: 수집 시간창(시간 단위, 기본 24)
# TIME_WINDOW_HOURS=24
